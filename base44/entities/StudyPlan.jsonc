{
  "name": "StudyPlan",
  "type": "object",
  "properties": {
    "exam_date": {
      "type": "string",
      "format": "date"
    },
    "daily_minutes": {
      "type": "number",
      "default": 45
    },
    "study_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "reminder_time": {
      "type": "string",
      "default": "18:30"
    },
    "cheer_style": {
      "type": "string",
      "enum": [
        "calm",
        "playful",
        "hype"
      ],
      "default": "playful"
    },
    "goal_note": {
      "type": "string"
    },
    "onboarded": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "exam_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}